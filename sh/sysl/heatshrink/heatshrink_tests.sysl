module sh.sysl.heatshrink
@tests
@requires(heap, os)

// How many inputs `sample` knows.
private[heatshrink] const SAMPLES: int = 9

// A deterministic stream of bytes that does not repeat for a long while.
private[heatshrink] fill(out: []u8, seed: u64)
    var x = seed
    for i in 0..<out.len
        x = (x * 1103515245 + 12345) % 2147483648
        out[i] = u8((x / 65536) % 256)

// Input number `kind` into the front of `out` (at least 8192 bytes); answers its length.
private[heatshrink] sample(kind: int, out: []u8) -> usize
    if kind == 0 then return 0
    if kind == 1
        out[0] = 120
        return 1
    if kind == 2
        out[0] = 1
        out[1] = 1
        return 2
    if kind == 3
        for i in 0..<600
            out[i] = 97
        return 600
    if kind == 4
        val text = "the quick brown fox jumps over the lazy dog, and then the lazy dog jumps over the quick brown fox. "
        for i in 0..<1000usize
            out[i] = text.bytes[i % text.len]
        return 1000
    if kind == 5
        fill(out[0..<700], 99)
        return 700
    if kind == 6
        // a pattern longer than the window, so no match can reach the previous period
        fill(out[0..<300], 5)
        for i in 300..<3000
            out[i] = out[i - 300]
        return 3000
    if kind == 7
        // noise with repeated runs of it, at distances inside and outside the window
        fill(out[0..<5000], 17)
        for i in 1000..<1200
            out[i] = out[i - 100]
        for i in 3000..<3300
            out[i] = out[i - 2000]
        return 5000
    // every byte value, in order, twice
    for i in 0..<512
        out[i] = u8(i % 256)
    512

private roundtrip(input: []const u8)
    var comp: [8192]u8 = [0; 8192]
    var back: [8192]u8 = [0; 8192]
    val n = compress(input, comp[0..<8192]).unwrap()
    assert(n <= input.len + input.len / 8 + 2, "the output exceeds the documented bound")
    val m = decompress(comp[0..<n], back[0..<8192]).unwrap()
    assert_eq(m, input.len)
    for i in 0..<m
        assert_eq(back[i], input[i])

@test("every sample survives a round trip through the one-shot helpers")
samples_round_trip()
    var data: [8192]u8 = [0; 8192]
    for kind in 0..<SAMPLES
        val n = sample(kind, data[0..<8192])
        roundtrip(data[0..<n])

@test("an empty input compresses to nothing and decompresses to nothing")
empty_round_trip()
    var out: [16]u8 = [0; 16]
    assert_eq(compress("".bytes, out[0..<16]).unwrap(), 0)
    assert_eq(decompress("".bytes, out[0..<16]).unwrap(), 0)

@test("a long run of one byte becomes a few bytes")
a_run_compresses()
    var data: [8192]u8 = [0; 8192]
    var comp: [8192]u8 = [0; 8192]
    val n = sample(3, data[0..<8192])
    val c = compress(data[0..<n], comp[0..<8192]).unwrap()
    // a match is at most 16 bytes and costs 13 bits, so about 38 matches: 62 bytes
    assert(c < 70, "600 equal bytes should take under 70 bytes")
    assert(c > 40, "600 equal bytes cannot take under 40 bytes at 13 bits per 16")

@test("random bytes do not compress, and grow by no more than the documented bound")
noise_does_not_compress()
    var data: [8192]u8 = [0; 8192]
    var comp: [8192]u8 = [0; 8192]
    val n = sample(5, data[0..<8192])
    val c = compress(data[0..<n], comp[0..<8192]).unwrap()
    assert(c > n, "noise cannot shrink")
    assert(c <= n + n / 8 + 2, "noise grew more than a bit in eight")

@test("a repeat further back than the window is not found, one inside it is")
the_window_is_256_bytes()
    var data: [8192]u8 = [0; 8192]
    var comp: [8192]u8 = [0; 8192]
    // 100 noise bytes then the same 100: inside the window, so the copy is nearly free
    fill(data[0..<100], 3)
    for i in 100..<200
        data[i] = data[i - 100]
    val near = compress(data[0..<200], comp[0..<8192]).unwrap()
    // 300 noise bytes then the same 300: the window is 256, so no copy reaches back far enough to start it
    fill(data[0..<300], 3)
    for i in 300..<600
        data[i] = data[i - 300]
    val far = compress(data[0..<600], comp[0..<8192]).unwrap()
    assert(near < 130, "100 bytes repeated at distance 100 should cost little more than the 100")
    assert(far > 340, "300 bytes repeated at distance 300 are out of the window and cost as much again")

// Compress `input` through the streaming interface: `step` bytes offered at a time, `room` bytes of
// output polled at a time. Answers the length written to `out`.
private stream_encode(input: []const u8, step: usize, room: usize, out: []u8) -> usize
    var enc = encoder()
    var n = 0usize
    var at = 0usize
    while at < input.len
        val end = if at + step < input.len then at + step else input.len
        var piece = at
        while piece < end
            piece += enc.sink(input[piece..<end]).unwrap()
            n += pump_encoder(&enc, out, n, room)
        at = end
    loop
        val more = enc.finish().unwrap()
        n += pump_encoder(&enc, out, n, room)
        if !more then break
    n

private pump_encoder(enc: *Encoder, out: []u8, at: usize, room: usize) -> usize
    var n = 0usize
    loop
        val p = enc.poll(out[at + n ..< at + n + room]).unwrap()
        n += p.written
        if !p.more then break
    n

private stream_decode(input: []const u8, step: usize, room: usize, out: []u8) -> usize
    var dec = decoder()
    var n = 0usize
    var at = 0usize
    while at < input.len
        val end = if at + step < input.len then at + step else input.len
        var piece = at
        while piece < end
            piece += dec.sink(input[piece..<end]).unwrap()
            n += pump_decoder(&dec, out, n, room)
        at = end
    loop
        val more = dec.finish().unwrap()
        n += pump_decoder(&dec, out, n, room)
        if !more then break
    n

private pump_decoder(dec: *Decoder, out: []u8, at: usize, room: usize) -> usize
    var n = 0usize
    loop
        val p = dec.poll(out[at + n ..< at + n + room]).unwrap()
        n += p.written
        if !p.more then break
    n

@test("the streaming interface gives the one-shot bytes however it is fed and drained")
streaming_matches_one_shot()
    var data: [8192]u8 = [0; 8192]
    var whole: [8192]u8 = [0; 8192]
    var piecewise: [8192]u8 = [0; 8192]
    var back: [8192]u8 = [0; 8192]
    val steps: [5]usize = [1, 3, 7, 33, 1000]
    val rooms: [4]usize = [1, 2, 5, 64]
    for kind in 3..<SAMPLES
        val n = sample(kind, data[0..<8192])
        val expected = compress(data[0..<n], whole[0..<8192]).unwrap()
        for s in steps
            for r in rooms
                val got = stream_encode(data[0..<n], s, r, piecewise[0..<8192])
                assert_eq(got, expected)
                for i in 0..<got
                    assert_eq(piecewise[i], whole[i])
                val m = stream_decode(whole[0..<expected], s, r, back[0..<8192])
                assert_eq(m, n)
                for i in 0..<m
                    assert_eq(back[i], data[i])

@test("the decoder takes only what its input buffer holds, and takes more once polled")
decoder_input_buffer_fills()
    var dec = decoder()
    var block: [64]u8 = [0; 64]
    var out: [8192]u8 = [0; 8192]
    assert_eq(dec.sink(block[0..<64]).unwrap(), INPUT_BUFFER_SIZE)
    assert_eq(dec.sink(block[0..<64]).unwrap(), 0)
    // nothing was decoded to a stopping place yet; polling drains the buffer
    dec.poll(out[0..<8192]).unwrap()
    assert(dec.sink(block[0..<64]).unwrap() > 0, "a polled decoder has room again")

@test("a compress into a buffer that is too small is OutputFull, and a buffer of exactly the size is not")
output_too_small()
    var data: [8192]u8 = [0; 8192]
    var comp: [8192]u8 = [0; 8192]
    for kind in 1..<SAMPLES
        val n = sample(kind, data[0..<8192])
        val size = compress(data[0..<n], comp[0..<8192]).unwrap()
        assert_eq(compress(data[0..<n], comp[0..<size]).unwrap(), size)
        assert_eq(compress(data[0..<n], comp[0..<(size - 1)]).unwrap_err(), Error.OutputFull)
        assert_eq(compress(data[0..<n], comp[0..<0]).unwrap_err(), Error.OutputFull)

@test("a decompress into a buffer that is too small is OutputFull, and a buffer of exactly the size is not")
decompressed_output_too_small()
    var data: [8192]u8 = [0; 8192]
    var comp: [8192]u8 = [0; 8192]
    var back: [8192]u8 = [0; 8192]
    for kind in 1..<SAMPLES
        val n = sample(kind, data[0..<8192])
        val size = compress(data[0..<n], comp[0..<8192]).unwrap()
        assert_eq(decompress(comp[0..<size], back[0..<n]).unwrap(), n)
        assert_eq(decompress(comp[0..<size], back[0..<(n - 1)]).unwrap_err(), Error.OutputFull)
        assert_eq(decompress(comp[0..<size], back[0..<0]).unwrap_err(), Error.OutputFull)

@test("a decoder says output remains while input is unpolled, and is done once it is drained")
decoder_finish_reports_what_remains()
    var comp: [64]u8 = [0; 64]
    var back: [64]u8 = [0; 64]
    val n = compress(GOLDEN_TEXT.bytes, comp[0..<64]).unwrap()
    var dec = decoder()
    assert_eq(dec.sink(comp[0..<n]).unwrap(), n)
    assert(dec.finish().unwrap(), "input has been sunk and not polled")
    var got = 0usize
    loop
        val p = dec.poll(back[got..<64]).unwrap()
        got += p.written
        if !p.more then break
    assert_eq(got, GOLDEN_TEXT.len)
    assert(!dec.finish().unwrap(), "everything has been polled")

@test("an encoder says output remains after finish until it is polled dry")
encoder_finish_reports_what_remains()
    var comp: [64]u8 = [0; 64]
    var enc = encoder()
    assert_eq(enc.sink(GOLDEN_TEXT.bytes).unwrap(), GOLDEN_TEXT.len)
    assert(enc.finish().unwrap(), "output remains after finish")
    var got = 0usize
    loop
        val p = enc.poll(comp[got..<64]).unwrap()
        got += p.written
        if !p.more then break
    assert_eq(got, 17usize)
    assert(!enc.finish().unwrap(), "everything has been polled")

@test("an encoder sunk into after finish is Misuse")
sink_after_finish_is_misuse()
    var enc = encoder()
    enc.finish().unwrap()
    assert_eq(enc.sink("abc".bytes).unwrap_err(), Error.Misuse)

@test("polling into an empty slice is Misuse")
poll_into_nothing_is_misuse()
    var enc = encoder()
    var none: [1]u8 = [0]
    assert_eq(enc.poll(none[0..<0]).unwrap_err(), Error.Misuse)

@test("an encoder reset starts over, and gives the bytes a fresh one gives")
reset_starts_over()
    var enc = encoder()
    var data: [8192]u8 = [0; 8192]
    var first: [8192]u8 = [0; 8192]
    var again: [8192]u8 = [0; 8192]
    val n = sample(4, data[0..<8192])
    val a = stream_encode_with(&enc, data[0..<n], first[0..<8192])
    enc.reset()
    val b = stream_encode_with(&enc, data[0..<n], again[0..<8192])
    assert_eq(a, b)
    for i in 0..<a
        assert_eq(first[i], again[i])

private stream_encode_with(enc: *Encoder, input: []const u8, out: []u8) -> usize
    var n = 0usize
    var at = 0usize
    while at < input.len
        at += enc.sink(input[at..<input.len]).unwrap()
        n += pump_encoder(enc, out, n, 64)
    loop
        val more = enc.finish().unwrap()
        n += pump_encoder(enc, out, n, 64)
        if !more then break
    n

// What heatshrink with an 8-bit window and a 4-bit lookahead makes of "heatshrink heatshrink
// heatshrink!", taken from the C library driven directly. A window or lookahead of another size
// changes these bytes, and so does any change to the format.
private val GOLDEN_TEXT: string = "heatshrink heatshrink heatshrink!"
private val GOLDEN: [17]u8 = [180, 89, 108, 55, 75, 157, 162, 229, 105, 183, 90, 228, 0, 175, 5, 36, 132]

@test("a known text compresses to the bytes the C library gives, and those decompress to it")
golden_vector()
    var comp: [64]u8 = [0; 64]
    var back: [64]u8 = [0; 64]
    val n = compress(GOLDEN_TEXT.bytes, comp[0..<64]).unwrap()
    assert_eq(n, 17usize)
    for i in 0..<17usize
        assert_eq(comp[i], GOLDEN[i])
    val m = decompress(GOLDEN[0..<17], back[0..<64]).unwrap()
    assert_eq(m, GOLDEN_TEXT.len)
    for i in 0..<m
        assert_eq(back[i], GOLDEN_TEXT.bytes[i])

@test("the package is built for the window and lookahead the documentation says")
the_parameters()
    assert_eq(WINDOW_BITS, 8)
    assert_eq(LOOKAHEAD_BITS, 4)
    assert_eq(INPUT_BUFFER_SIZE, 32usize)
